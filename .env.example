# Runtime
NODE_ENV=development
PORT=3000
HOST=0.0.0.0
LOG_LEVEL=info

# PostgreSQL
DATABASE_URL=postgresql://app:app@localhost:5432/transaction_api
TEST_DATABASE_URL=postgresql://app:app@localhost:5432/transaction_api_test

# Use a random value of at least 32 characters outside local development.
JWT_SECRET=replace-this-with-a-random-secret-at-least-32-characters
JWT_EXPIRES_IN=1h
